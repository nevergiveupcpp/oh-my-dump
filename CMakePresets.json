{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "preset-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "IDA_SDK_DIR": "$env{IDA_ROOT}/ida-sdk"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "preset-base",
      "generator": "Visual Studio 17 2022",
      "toolset": "v143",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "windows-x86-64",
      "inherits": "windows-base",
      "displayName": "Windows x86-64 Release",
      "cacheVariables": {
        "CMAKE_GENERATOR_PLATFORM": "x64",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-arm64",
      "inherits": "windows-base",
      "displayName": "Windows ARM64 Release",
      "cacheVariables": {
        "CMAKE_GENERATOR_PLATFORM": "ARM64",
        "VCPKG_TARGET_TRIPLET": "arm64-windows"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "preset-base",
      "generator": "Ninja Multi-Config"
    },
    {
      "name": "linux-x86-64",
      "inherits": "linux-base",
      "displayName": "Linux x86-64 Release",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-arm64",
      "inherits": "linux-base",
      "displayName": "Linux ARM64 Release",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-linux"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "preset-base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0"
      }
    },
    {
      "name": "macos-x86-64",
      "inherits": "macos-base",
      "displayName": "macOS x86-64 Release",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "VCPKG_TARGET_TRIPLET": "x64-osx"
      }
    },
    {
      "name": "macos-arm64",
      "inherits": "macos-base",
      "displayName": "macOS ARM64 Release",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x86-64",
      "configurePreset": "windows-x86-64",
      "configuration": "Release"
    },
    {
      "name": "windows-arm64",
      "configurePreset": "windows-arm64",
      "configuration": "Release"
    },
    {
      "name": "linux-x86-64",
      "configurePreset": "linux-x86-64",
      "configuration": "Release"
    },
    {
      "name": "linux-arm64",
      "configurePreset": "linux-arm64",
      "configuration": "Release"
    },
    {
      "name": "macos-x86-64",
      "configurePreset": "macos-x86-64",
      "configuration": "Release"
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "configuration": "Release"
    }
  ]
}
